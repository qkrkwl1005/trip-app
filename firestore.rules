rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /rooms/{roomId} {
      function isMember(data) {
        return request.auth != null
          && data.members[request.auth.uid].role in ['owner', 'editor'];
      }
      function validRoom(data) {
        return data.keys().hasOnly(['items', 'trip', 'updatedAt', 'ownerUid', 'members', 'settings', 'settingsShared', 'revision', 'history'])
          && data.items is list
          && data.items.size() <= 200
          && (!data.keys().hasAny(['trip']) || (
            data.trip is map
            && data.trip.keys().hasOnly(['title', 'start', 'end', 'flights', 'stays', 'notes'])
            && data.trip.title is string
            && data.trip.title.size() <= 100
            && data.trip.start is string
            && data.trip.end is string
            && data.trip.flights is list
            && data.trip.flights.size() <= 20
            && data.trip.stays is list
            && data.trip.stays.size() <= 20
            && data.trip.notes is list
            && data.trip.notes.size() <= 50
          ))
          && data.ownerUid is string
          && data.members is map
          && data.settingsShared is bool
          && data.settings is map
          && data.revision is number
          && data.history is list
          && data.history.size() <= 10;
      }
      // Temporary room-code access: membership is established by the client
      // after the authenticated user successfully opens the room.
      allow read, write: if request.auth != null;
      match /joinRequests/{uid} {
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'createdAt'])
          && request.resource.data.uid == uid;
        allow read, delete: if request.auth != null
          && (
            request.auth.uid == uid
            || get(/databases/$(database)/documents/rooms/$(roomId)).data.ownerUid == request.auth.uid
          );
      }
    }
  }
}
